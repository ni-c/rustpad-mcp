{
  "name": "rustpad-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.ni-c/rustpad-mcp",
  "description": "MCP server for Rustpad, the self-hosted collaborative text editor",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rustpad",
    "collaborative-editing",
    "selfhosted"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/rustpad-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/rustpad-mcp/issues"
  },
  "homepage": "https://github.com/ni-c/rustpad-mcp#readme",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "bin": {
    "rustpad-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "assets": "node scripts/gen-assets.mjs",
    "assets:check": "node scripts/gen-assets.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
